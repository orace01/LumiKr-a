# Variables du serveur. Copier ce fichier en `.env` (ignoré par Git) et le
# remplir ; ne jamais y mettre de vraies clés dans le dépôt.
# En production, les définir plutôt dans l'interface de l'hébergeur.
# Pour les charger depuis .env : node --env-file=.env dist-server/main.js

# demo : prix fictifs, paiement et fournisseur simulés · live : vente réelle.
# Par défaut : demo avec `npm run dev`, live avec `npm start`.
SHOP_MODE=

# Adresse publique du site, utilisée pour les liens de retour du paiement.
PUBLIC_URL=https://www.exemple.fr

# Port du serveur de production (3000 par défaut).
PORT=3000

# Dossier où sont enregistrées les commandes (data par défaut).
DATA_DIR=data

# Jeton pour GET /api/admin/orders et POST /api/admin/orders/:id/fulfill.
# Une longue chaîne aléatoire ; sans elle, ces routes sont désactivées.
ADMIN_TOKEN=

# --- Agrégateur de paiement (server/payment/aggregator.ts) ---
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- CJdropshipping (server/fulfillment/cj.ts) ---
# Clé API, à générer dans la rubrique API du tableau de bord CJ (format CJ…@api@…).
# Vérifier ensuite la connexion : npm run cj -- verifier
CJ_API_KEY=
# Pays de l'entrepôt CJ d'où partent les colis (CN par défaut).
# `npm run cj -- produit` montre le stock par pays.
CJ_FROM_COUNTRY=CN
# 2 : la commande CJ est payée automatiquement sur ton solde CJ (par défaut).
# 3 : elle est seulement créée ; tu la paies toi-même dans le tableau de bord CJ.
CJ_PAY_TYPE=2
# 1 : commandes de test CJ, ni débitées ni expédiées. Aussi le seul cas où
# `npm run dev` (paiement simulé) envoie les commandes à CJ.
CJ_SANDBOX=
# TVA à l'import dans l'UE (IOSS), obligatoire pour livrer dans l'UE (sinon CJ
# refuse la commande) : 1 sans IOSS, 2 ton numéro IOSS (dans CJ_IOSS_NUMBER),
# 3 l'IOSS de CJ, qui déclare la TVA et la facture sur chaque commande.
CJ_IOSS_TYPE=3
CJ_IOSS_NUMBER=
# Intervalle minimal entre deux appels CJ, en ms. 1100 par défaut (compte CJ
# gratuit : 1 appel par seconde) ; 550 pour un compte Plus, 250 pour Prime.
CJ_MIN_INTERVAL_MS=
